# Vanilla refactor: every UndergroundBiomes rock (rhyolite, soapstone, shale,
# siltstone, basalt) was replaced with plain stone. Modded biomes removed.
# All layers now place stone on stone, so this preset currently changes nothing;
# the layers are kept so they can be re-themed.
{
  biomes: {
    names: [
      minecraft:swampland
      minecraft:mutated_swampland
      minecraft:river
    ]
  }
  layers: [
    {
      #rhyolite
      state: minecraft:stone
      height: [ 0, 16 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #soapstone
      state: minecraft:stone
      height: [ 0, 44 ]
      ceiling: {
        frequency: 0.015
        range: [ -3, 3 ]
      }
    }
    {
      #shale
      state: minecraft:stone
      height: [ 0, 60 ]
      ceiling: {
        frequency: 0.015
        range: [ -3, 3 ]
      }
    }
    {
      #siltstone
      state: minecraft:stone
      height: [ 0, 86 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #basalt
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.017
        range: [ -4, 3 ]
      }
    }
  ]
}
