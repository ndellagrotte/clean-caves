# Vanilla refactor: UndergroundBiomes rocks (andesite, greywacke) were replaced
# with plain stone; greywacke sandstone->smooth sandstone, greywacke sand->sandstone.
# Layers only replace plain stone, so each sandstone layer has a floor to keep it
# from also replacing the stone bands below it. Modded biomes removed.
{
  biomes: {
    names: [
      minecraft:desert
      minecraft:desert_hills
      minecraft:mutated_desert
    ]
  }
  wallDecorators: [
    # Spawns desert varnish underground.
    {
      states: minecraft:stained_hardened_clay:12
      matchers: [ "sandstone" ]
      directions: all
      height: [ 26, 90 ]
      integrity: 0.25
    }
  ]
  layers: [
    {
      #andesite bedrock
      state: minecraft:stone
      height: [ 0, 26 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #underground sandstone
      state: minecraft:sandstone
      height: [ 26, 90 ]
      floor: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
      ceiling: {
        frequency: 0.015
        range: [ -4, 4 ]
      }
    }
    {
      #greywacke
      state: minecraft:stone
      height: [ 0, 110 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #greywacke sandstone
      state: minecraft:sandstone:2
      height: [ 110, 150 ]
      floor: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
      ceiling: {
        frequency: 0.015
        range: [ -1, 1 ]
      }
    }
    {
      #greywacke sand
      state: minecraft:sandstone
      height: [ 150, 255 ]
      floor: {
        frequency: 0.015
        range: [ -1, 1 ]
      }
      ceiling: {
        frequency: 0.015
        range: [ -1, 1 ]
      }
    }
  ]
}
