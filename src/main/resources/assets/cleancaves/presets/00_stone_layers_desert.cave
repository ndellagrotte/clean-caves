# Vanilla refactor: UndergroundBiomes blocks were replaced with vanilla equivalents
# (andesite->andesite, greywacke->gray terracotta, greywacke sandstone->smooth
#  sandstone, greywacke sand->sandstone). Modded biomes removed.
{
  biomes: {
    names: [
      minecraft:desert
      minecraft:desert_hills
      minecraft:mutated_desert
    ]
  }
  wallDecorators: [
    # Spawns desert varnish underground.
    {
      states: minecraft:stained_hardened_clay:12
      matchers: [ "sandstone" ]
      directions: all
      height: [ 26, 90 ]
      integrity: 0.25
    }
  ]
  layers: [
    {
      #andesite bedrock
      state: minecraft:stone:5
      height: [ 0, 26 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #underground sandstone
      state: minecraft:sandstone
      height: [ 0, 90 ]
      ceiling: {
        frequency: 0.015
        range: [ -4, 4 ]
      }
    }
    {
      #greywacke
      state: minecraft:stained_hardened_clay:7
      height: [ 0, 110 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #greywacke sandstone
      state: minecraft:sandstone:2
      height: [ 0, 150 ]
      ceiling: {
        frequency: 0.015
        range: [ -1, 1 ]
      }
    }
    {
      #greywacke sand
      state: minecraft:sandstone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.015
        range: [ -1, 1 ]
      }
    }
  ]
}
