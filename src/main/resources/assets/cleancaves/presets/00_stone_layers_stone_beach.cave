# Vanilla refactor: every UndergroundBiomes rock (dacite, soapstone, chalk) was
# replaced with plain stone.
# All layers now place stone on stone, so this preset currently changes nothing;
# the layers are kept so they can be re-themed.
{
  biomes: {
    names: [
      minecraft:stone_beach
    ]
  }
  layers: [
    {
      #dacite
      state: minecraft:stone
      height: [ 0, 18 ]
      ceiling: {
        frequency: 0.015
        range: [ -7, 4 ]
      }
    }
    {
      #soapstone
      state: minecraft:stone
      height: [ 0, 48 ]
      ceiling: {
        frequency: 0.015
      }
    }
    {
      #chalk
      state: minecraft:stone
      height: [ 0, 164 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 8 ]
      }
    }
    {
      #dacite
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.015
        range: [ -7, 9 ]
      }
    }
  ]
}
