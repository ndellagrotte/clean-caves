      minecraft:mutated_taiga
      minecraft:mutated_taiga_cold
      minecraft:mutated_redwood_taiga
      minecraft:mutated_redwood_taiga_hills
    ]
  }
  layers: [
    {
      #dacite
      state: minecraft:stone
      height: [ 0, 18 ]
      ceiling: {
        frequency: 0.015
        range: [ -7, 4 ]
      }
    }
    {
      #soapstone
      state: minecraft:stone
      height: [ 0, 61 ]
      ceiling: {
        frequency: 0.015
      }
    }
    {
      #chalk
      state: minecraft:stone
      height: [ 0, 128 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 8 ]
      }
    }
    {
      #dacite
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.015
        range: [ -7, 9 ]
      }
    }
  ]
