# Vanilla refactor: every UndergroundBiomes rock (red granite, gabbro, limestone)
# was replaced with plain stone. Modded biomes removed.
# All layers now place stone on stone, so this preset currently changes nothing;
# the layers are kept so they can be re-themed.
{
  biomes: {
    names: [
      minecraft:ocean
      minecraft:deep_ocean
    ]
  }
  layers: [
    {
      #red granite
      state: minecraft:stone
      height: [ 0, 26 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #gabbro
      state: minecraft:stone
      height: [ 0, 58 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #limestone
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
  ]
}
