# Vanilla refactor: UndergroundBiomes rocks (red granite, gneiss, limestone,
# shale) were replaced with plain stone; shale sandstone->red sandstone. Layers
# only replace plain stone, so the red sandstone layer has a floor to keep it
# from also replacing the stone below it. Mutated mesa biomes added.
{
  biomes: {
    names: [
      minecraft:mesa
      minecraft:mesa_rock
      minecraft:mesa_clear_rock
      minecraft:mutated_mesa
      minecraft:mutated_mesa_rock
      minecraft:mutated_mesa_clear_rock
    ]
  }
  layers: [
    {
      #red granite
      state: minecraft:stone
      height: [ 0, 16 ]
      ceiling: {
        frequency: 0.015
        range: [ -7, 4 ]
      }
    }
    {
      #gneiss
      state: minecraft:stone
      height: [ 0, 48 ]
      ceiling: {
        frequency: 0.015
      }
    }
    {
      #limestone
      state: minecraft:stone
      height: [ 0, 58 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 4 ]
      }
    }
    {
      #shale
      state: minecraft:stone
      height: [ 0, 204 ]
      ceiling: {
        frequency: 0.9
        range: [ -16, 16 ]
      }
    }
    {
      #shale sandstone
      state: minecraft:red_sandstone
      height: [ 204, 255 ]
      floor: {
        frequency: 0.9
        range: [ -16, 16 ]
      }
      ceiling: {
        frequency: 0.9
        range: [ 2, 16 ]
      }
    }
  ]
}
