# Vanilla refactor: UndergroundBiomes rocks (red granite, andesite, limestone)
# were replaced with plain stone; BOP hard ice->packed ice. Layers only replace
# plain stone, so the ice layer has a floor to keep it from also replacing the
# stone below it. Modded biomes removed.
{
  biomes: {
    names: [
      minecraft:ice_flats
      minecraft:ice_mountains
      minecraft:frozen_ocean
      minecraft:frozen_river
      minecraft:cold_beach
      minecraft:mutated_ice_flats
    ]
  }
  layers: [
    {
      #red granite
      state: minecraft:stone
      height: [ 0, 12 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #andesite
      state: minecraft:stone
      height: [ 0, 48 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #hard ice
      state: minecraft:packed_ice
      height: [ 48, 64 ]
      floor: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
      ceiling: {
        frequency: 0.015
        range: [ -4, 4 ]
      }
    }
    {
      #limestone
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
  ]
}
