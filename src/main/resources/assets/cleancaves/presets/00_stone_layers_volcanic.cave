# Vanilla refactor: every UndergroundBiomes rock (rhyolite, komatiite, basalt,
# dolomite) was replaced with plain stone. Modded biomes removed.
# All layers now place stone on stone, so this preset currently changes nothing;
# the layers are kept so they can be re-themed.
{
  biomes: {
    names: [
      minecraft:mushroom_island
      minecraft:mushroom_island_shore
    ]
  }
  layers: [
    {
      #rhyolite
      state: minecraft:stone
      height: [ 0, 32 ]
      ceiling: {
        frequency: 0.019
        range: [ -8, 8 ]
      }
    }
    {
      #komatiite
      state: minecraft:stone
      height: [ 0, 58 ]
      ceiling: {
        frequency: 0.019
        range: [ -8, 8 ]
      }
    }
    {
      #basalt
      state: minecraft:stone
      height: [ 0, 64 ]
      ceiling: {
        frequency: 0.015
        range: [ -3, 3 ]
      }
    }
    {
      #dolomite
      state: minecraft:stone
      height: [ 0, 84 ]
      ceiling: {
        frequency: 0.015
        range: [ 0, 3 ]
      }
    }
    {
      #basalt
      state: minecraft:stone
      height: [ 0, 255 ]
      ceiling: {
        frequency: 0.017
        range: [ -4, 3 ]
      }
    }
  ]
}
